{
    "name":  "xianzhi-ai-user-uni",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "typecheck":  "vue-tsc --noEmit",
                    "test:wallet":  "node --test tests/personal-points-wallet.test.ts tests/personal-points-wallet-coordinator.test.ts",
                    "test:wallet-build":  "node --test tests/wallet-subpackage-output.test.mjs",
                    "build:h5":  "uni build -p h5 --mode production",
                    "build:mp-weixin":  "node scripts/build-mp-weixin-release.cjs",
                    "build:mp-weixin:local":  "uni build -p mp-weixin && node scripts/patch-mp-native-login.cjs && node scripts/check-mp-package-size.cjs",
                    "check:mp-weixin-package":  "node scripts/check-mp-package-size.cjs",
                    "build:app-plus":  "uni build -p app-plus",
                    "build:app-ios":  "uni build -p app-plus",
                    "check:app-release":  "node scripts/check-app-release.mjs",
                    "check:app-ios-release":  "node scripts/check-app-release.mjs --platform ios",
                    "build:app-plus:release":  "node scripts/check-app-release.mjs && uni build -p app-plus --mode production",
                    "build:app-ios:release":  "node scripts/check-app-release.mjs --platform ios && uni build -p app-plus --mode production",
                    "build:app-harmony":  "uni build -p app-harmony",
                    "build:mp-harmony":  "uni build -p mp-harmony"
                },
    "dependencies":  {
                         "@dcloudio/types":  "3.4.31",
                         "@dcloudio/uni-app":  "3.0.0-5010520260709002",
                         "@dcloudio/uni-app-plus":  "3.0.0-5010520260709002",
                         "@dcloudio/uni-h5":  "3.0.0-5010520260709002",
                         "@dcloudio/uni-mp-weixin":  "3.0.0-5010520260709002",
                         "@dcloudio/vite-plugin-uni":  "3.0.0-5010520260709002",
                         "pinia":  "^3.0.4",
                         "qrcode-generator":  "^2.0.4",
                         "typescript":  "^5.8.3",
                         "vite":  "5.2.8",
                         "vue":  "3.5.35",
                         "vue-tsc":  "^2.2.10"
                     }
}
