{
    "name":  "xianzhi-ai-user-uni",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "uni -p h5 --host 0.0.0.0",
                    "build":  "uni build -p h5 && node scripts/copy-static.cjs",
                    "typecheck":  "vue-tsc --noEmit",
                    "preview":  "vite preview --host 0.0.0.0 --outDir dist/build/h5",
                    "build:h5":  "uni build -p h5",
                    "build:mp-weixin":  "uni build -p mp-weixin && node scripts/patch-mp-native-login.cjs",
                    "build:app-plus":  "uni build -p app-plus",
                    "build:app-harmony":  "uni build -p app-harmony",
                    "build:mp-harmony":  "uni build -p mp-harmony"
                },
    "dependencies":  {
                         "@dcloudio/uni-app":  "3.0.0-alpha-1000920260615733",
                         "@dcloudio/uni-app-plus":  "^3.0.0-alpha-1000920260615733",
                         "@dcloudio/uni-h5":  "3.0.0-alpha-1000920260615733",
                         "@dcloudio/uni-mp-weixin":  "^3.0.0-alpha-1000920260615733",
                         "@dcloudio/vite-plugin-uni":  "3.0.0-alpha-1000920260615733",
                         "pinia":  "^3.0.4",
                         "typescript":  "^5.8.3",
                         "vite":  "7.3.3",
                         "vue":  "3.5.35",
                         "vue-tsc":  "^2.2.10"
                     }
}
