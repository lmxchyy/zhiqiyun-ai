{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@dcloudio/types"],
    "baseUrl": ".",
    "paths": {
      "@xianzhi/api-client": ["../../packages/api-client/src"],
      "@xianzhi/business-sdk": ["../../packages/business-sdk/src"],
      "@xianzhi/design-token": ["../../packages/design-token/src"],
      "@xianzhi/platform-adapter": ["../../packages/platform-adapter/src"],
      "@xianzhi/shared-auth": ["../../packages/shared-auth/src"],
      "@xianzhi/shared-image-utils": ["../../packages/shared-image-utils/src"],
      "@xianzhi/shared-types": ["../../packages/shared-types/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"]
}
