{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "先知 AI",
  "version": "0.1.0",
  "identifier": "ai.xianzhi.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../user-uni run dev",
    "beforeBuildCommand": "npm --prefix ../user-uni run build:h5",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../user-uni/dist/build/h5"
  },
  "app": {
    "windows": [
      {
        "title": "先知 AI",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
