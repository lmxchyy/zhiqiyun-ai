# Copy this file to .env on the server and replace every example value.
# Never commit real production secrets.

COMPOSE_PROJECT_NAME=xianzhi-ai-prod
APP_BIND_HOST=127.0.0.1
APP_PORT=3100

XIANZHI_ENV=production
XIANZHI_IMAGE=xianzhi-ai-platform
IMAGE_TAG=prod
XIANZHI_ENFORCE_RBAC=true
XIANZHI_ENABLE_MOCK_LOGIN=false
XIANZHI_ALLOW_WECHAT_MOCK_LOGIN=false
XIANZHI_DEV_AUTH_FALLBACK=false
XIANZHI_ALLOW_INSECURE_AUTH_TOKEN=false
INSTALL_OFFICECLI=false
OFFICECLI_INSTALL_URL=https://raw.githubusercontent.com/iOfficeAI/OfficeCLI/main/install.sh
# Required only when INSTALL_OFFICECLI=true. Use the SHA256 of OFFICECLI_INSTALL_URL after reviewing the script.
OFFICECLI_INSTALL_SHA256=
# Leave empty for same-origin deployments. Use comma-separated exact origins only when H5 must call the API cross-origin.
XIANZHI_CORS_ALLOWED_ORIGINS=

POSTGRES_DB=xianzhi
POSTGRES_USER=xianzhi_prod
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql://xianzhi_prod:change-me-postgres-password@postgres:5432/xianzhi?sslmode=disable

REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379

RABBITMQ_DEFAULT_USER=xianzhi_prod
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password
RABBITMQ_URL=amqp://xianzhi_prod:change-me-rabbitmq-password@rabbitmq:5672

MINIO_ROOT_USER=xianzhi_prod
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
S3_ENDPOINT=http://minio:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=xianzhi_prod
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=xianzhi-assets
S3_REGION=

# Platform file center. Use a random 32+ byte secret; never commit the real value.
STORAGE_MASTER_KEY=change-me-32-byte-storage-master-key
STORAGE_DEFAULT_PROVIDER=minio
STORAGE_DEFAULT_QUOTA_BYTES=10737418240
STORAGE_MAX_UPLOAD_BYTES=2147483648
STORAGE_UPLOAD_URL_TTL_SECONDS=600
STORAGE_ACCESS_URL_TTL_SECONDS=900
STORAGE_RECYCLE_DAYS=30
STORAGE_AUTO_CREATE_BUCKET=true
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_DOMAIN=
STORAGE_CDN_DOMAIN=

# Operation media center. local is fully runnable and stored in the app-data volume.
# aliyun_oss / tencent_cos / qiniu / s3 select deployment adapters when installed.
MEDIA_STORAGE_PROVIDER=local
MEDIA_STORAGE_ROOT=/app/data/media-assets
MEDIA_PUBLIC_BASE_URL=/api/v1/media/files
MEDIA_CDN_BASE_URL=
MEDIA_MAX_UPLOAD_BYTES=12582912
MEDIA_KEEP_ORIGINAL=true
ASSET_STORAGE_QUOTA_BYTES=10737418240

PAYMENT_CALLBACK_SECRET=change-me-payment-callback-secret
ANDROID_PAYMENT_CAPABILITY=preparing
ANDROID_PAYMENT_CHANNEL=wechat_app
WECHAT_MINI_PROGRAM_APPID=change-me-mini-program-appid
WECHAT_MINI_PROGRAM_SECRET=change-me-mini-program-secret
WECHAT_MINI_PROGRAM_ENV_VERSION=develop
WECHAT_VIRTUAL_PAY_ENABLED=false
WECHAT_VIRTUAL_PAY_ENV=sandbox
WECHAT_VIRTUAL_PAY_OFFER_ID=change-me-wechat-virtual-offer-id
WECHAT_VIRTUAL_PAY_APP_KEY=change-me-wechat-virtual-production-app-key
WECHAT_VIRTUAL_PAY_SANDBOX_APP_KEY=change-me-wechat-virtual-sandbox-app-key
WECHAT_VIRTUAL_PAY_NOTIFY_TOKEN=change-me-wechat-virtual-notify-token
WECHAT_VIRTUAL_PAY_MODE=short_series_goods
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
SMS_TEMPLATE_ID=
# 仅本地联调使用，生产环境会忽略该值
XIANZHI_SMS_DEV_CODE=
WECHAT_PAY_API_V3_KEY=change-me-32-byte-wechat-pay-api-v3-key
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PEM=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_CALLBACK_SECRET=change-me-wechat-pay-callback-secret
ALIPAY_PUBLIC_KEY_PEM=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_CALLBACK_SECRET=change-me-alipay-callback-secret
METRICS_TOKEN=change-me-metrics-token

MODEL_PROVIDER_KIND=openai
MODEL_PROVIDER_URL=https://api.openai.com/v1
MODEL_PROVIDER_API_KEY=change-me-model-provider-api-key
CONTENT_AUDIT_OUTPUT_MODE=mock
ENTERPRISE_LEGAL_NAME=
LEGAL_USER_AGREEMENT_VERSION=
LEGAL_USER_AGREEMENT_CONTENT=
LEGAL_MEMBER_SERVICE_AGREEMENT_VERSION=
LEGAL_MEMBER_SERVICE_AGREEMENT_CONTENT=
LEGAL_AGENT_SERVICE_AGREEMENT_VERSION=
LEGAL_AGENT_SERVICE_AGREEMENT_CONTENT=
LEGAL_ENTERPRISE_SPACE_SERVICE_AGREEMENT_VERSION=
LEGAL_ENTERPRISE_SPACE_SERVICE_AGREEMENT_CONTENT=
LEGAL_RECHARGE_SERVICE_AGREEMENT_VERSION=
LEGAL_RECHARGE_SERVICE_AGREEMENT_CONTENT=
LEGAL_PRIVACY_POLICY_VERSION=
LEGAL_PRIVACY_POLICY_CONTENT=
LEGAL_AI_CONTENT_RULES_VERSION=
LEGAL_AI_CONTENT_RULES_CONTENT=
LEGAL_PLATFORM_CONVENTION_VERSION=
LEGAL_PLATFORM_CONVENTION_CONTENT=
LEGAL_MINOR_PROTECTION_VERSION=
LEGAL_MINOR_PROTECTION_CONTENT=
COMPLAINT_ENTRY_URL=
INFRINGEMENT_COMPLAINT_URL=
OPENAI_API_KEY=change-me-openai-api-key
OPENAI_BASE_URL=https://api.openai.com
MODEL_PROVIDER_IMAGE_MODEL=gpt-image-2
MODEL_PROVIDER_TEXT_MODEL=gpt-4o-mini
MODEL_PROVIDER_VIDEO_MODEL=sora-2
MODEL_PROVIDER_TIMEOUT_MS=30000
MODEL_PROVIDERS_JSON=

# CloudBase third-party deep-synthesis provider for the WeChat mini-program.
# Keep disabled until the CloudBase qualification materials and model compliance
# records have been reviewed. CLOUDBASE_API_KEY is server-only.
CLOUDBASE_ENABLED=false
CLOUDBASE_ENV_ID=
CLOUDBASE_IMAGE_FUNCTION_NAME=zhiqiyun-ai-image
CLOUDBASE_IMAGE_FUNCTION_URL=
CLOUDBASE_API_KEY=
CLOUDBASE_IMAGE_TIMEOUT_MS=150000
CLOUDBASE_AI_WATERMARK_TEXT=AI生成
MINIPROGRAM_CREATION_MODES=image,infographic

# 飞书企业自建应用 Connector（真实 App 凭据在企业中心配置并加密入库）
FEISHU_HTTP_TIMEOUT_SECONDS=10
FEISHU_TOKEN_CACHE_PREFIX=xianzhi:connector:feishu:token:
FEISHU_API_BASE_URL=https://open.feishu.cn/open-apis
# 视频/PPT沿用同一飞书应用、对象存储和模型中心，不新增平台密钥；上传文件限制由后端统一控制为100 MiB。
FEISHU_ACCOUNTS_BASE_URL=https://accounts.feishu.cn
CONNECTOR_CALLBACK_BASE_URL=http://localhost:3100
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_API_BASE_URL=https://api.weixin.qq.com
WECHAT_OPEN_AUTHORIZE_BASE_URL=https://open.weixin.qq.com
WECHAT_OPEN_REDIRECT_URL=https://your-domain.example/api/v1/auth/wechat/callback
# 至少 32 字节，生产环境必须通过 Secret 注入，禁止提交真实值
CONNECTOR_SECRET_ENCRYPTION_KEY=change-me-at-least-32-bytes-connector-key
CONNECTOR_QUEUE_PREFIX=xianzhi:connector:jobs:

PPT_MODEL_PROVIDER_URL=https://api.openai.com/v1
PPT_MODEL_PROVIDER_API_KEY=change-me-ppt-model-provider-api-key
PPT_TEXT_MODEL=gpt-4o-mini
PPT_MODEL_CHAT_DISABLE_THINKING=false
# PPT visual rollout controls. "local" disables only the planner model call;
# "disabled" stops automatic deck-wide image generation while keeping manual regeneration available.
PPT_VISUAL_PLANNER_MODE=model
PPT_AUTO_IMAGE_MODE=enabled
# strict rejects an image when configured OCR cannot validate it; fail_open is an emergency degradation mode.
PPT_VISUAL_OCR_FAILURE_MODE=strict
# Optional shared OCR endpoint. When configured, PPT visuals are checked for readable text before object-storage upload.
KNOWLEDGE_OCR_PROVIDER=
KNOWLEDGE_OCR_ENDPOINT=
KNOWLEDGE_OCR_API_KEY=

BACKUP_INTERVAL_SECONDS=86400

# Legitimate remote feature switches used during platform review. These flags only hide entry points;
# they never change authentication, authorization, tenant isolation, billing, or returned content.
REVIEW_MODE_ENABLED=false
REVIEW_MODE_HIDE_RECHARGE=false
REVIEW_MODE_HIDE_WALLET=false
REVIEW_MODE_HIDE_INVITE=false
REVIEW_MODE_HIDE_COMMISSION=false
REVIEW_MODE_HIDE_AGENT_CENTER=false
REVIEW_MODE_HIDE_OPERATOR_CENTER=false
REVIEW_MODE_HIDE_SENSITIVE_MARKETING=false
