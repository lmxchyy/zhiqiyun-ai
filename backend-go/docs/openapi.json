{
  "openapi": "3.0.3",
  "info": {
    "title": "Xianzhi AI User Core API",
    "version": "0.1.0",
    "description": "Initial OpenAPI contract for the shared user clients and business SDK."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "operationId": "loginByPassword",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
