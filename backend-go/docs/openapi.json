                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/plans": {
      "get": {
        "operationId": "listPlans",
        "responses": {
          "200": {
            "description": "Commerce plan list.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CommercePlan"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/CommercePlanItems"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/member/profile": {
      "get": {
        "operationId": "getMemberProfile",
        "responses": {
          "200": {
            "$ref": "#/components/responses/MemberProfileResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/member/wallet": {
      "get": {
        "operationId": "getMemberWallet",
        "responses": {
          "200": {
            "$ref": "#/components/responses/RoleWalletResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/points/account": {
      "get": {
        "operationId": "getPointsAccount",
        "responses": {
          "200": {
            "$ref": "#/components/responses/PointAccountResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/admin/points/expiry-policy": {
      "get": {
        "operationId": "getAdminPointExpiryPolicy",
        "responses": { "200": { "description": "Current personal point expiry policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PointExpiryPolicyResponse" } } } }, "401": { "$ref": "#/components/responses/ErrorResponse" }, "403": { "$ref": "#/components/responses/ErrorResponse" } }
      },
      "put": {
        "operationId": "updateAdminPointExpiryPolicy",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UpdatePointExpiryPolicyRequest" } } } },
        "responses": { "200": { "description": "Published personal point expiry policy", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PointExpiryPolicyResponse" } } } }, "400": { "$ref": "#/components/responses/ErrorResponse" }, "409": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/admin/customers/{id}/point-lots": {
      "get": {
        "operationId": "listAdminCustomerPointLots",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "source", "in": "query", "schema": { "type": "string" } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 0, "maximum": 500 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": { "200": { "description": "Customer point lots", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PersonalPointLotsResponse" } } } }, "401": { "$ref": "#/components/responses/ErrorResponse" }, "403": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/admin/customers/{id}/point-gifts": {
      "post": {
        "operationId": "grantAdminCustomerPointGift",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminPointMutationRequest" } } } },
        "responses": { "200": { "description": "Server-derived ADMIN_GIFT lot", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminPointGiftResponse" } } } }, "400": { "$ref": "#/components/responses/ErrorResponse" }, "409": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/admin/customers/{id}/point-corrections": {
      "post": {
        "operationId": "correctAdminCustomerPointBalance",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminPointMutationRequest" } } } },
        "responses": { "200": { "description": "Audited permanent point correction", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AdminPointCorrectionResponse" } } } }, "400": { "$ref": "#/components/responses/ErrorResponse" }, "409": { "$ref": "#/components/responses/ErrorResponse" } }
      }
    },
    "/api/v1/channel/me": {
      "get": {
        "operationId": "getChannelCenter",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ChannelCenterResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/operation-center/profile": {
      "get": {
        "operationId": "getOperationProfile",
        "responses": {
          "200": {
            "$ref": "#/components/responses/OperationProfileResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/operation-center/agents": {
      "get": {
        "operationId": "listOperationAgents",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ItemsResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/operation-center/orders": {
      "get": {
        "operationId": "listOperationOrders",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ItemsResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/operation-center/commissions": {
      "get": {
        "operationId": "listOperationCommissions",
        "responses": {
          "200": {
            "$ref": "#/components/responses/ItemsResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque"
      }
    },
    "responses": {
      "AuthResponse": {
        "description": "Authenticated user session.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AuthResponse"
            }
          }
        }
      },
      "UserAccessProfileResponse": {
        "description": "Current tenant, organization, roles and permissions for the authenticated user.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UserAccessProfile"
            }
          }
        }
      },
      "GenerationTaskResponse": {
        "description": "Generation task.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GenerationTask"
            }
          }
        }
      },
      "UserDashboardResponse": {
        "description": "User dashboard data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UserDashboardResponse"
            }
          }
        }
      },
      "PointAccountResponse": {
        "description": "Point account data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PointAccountResponse"
            }
          }
        }
      },
      "RoleWalletResponse": {
        "description": "Role wallet data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/RoleWalletResponse"
            }
          }
        }
      },
      "MemberProfileResponse": {
        "description": "Member profile data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/MemberProfileResponse"
            }
          }
        }
      },
      "ChannelCenterResponse": {
        "description": "Channel center data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ChannelCenterResponse"
            }
          }
        }
      },
      "OperationProfileResponse": {
        "description": "Operation center profile data.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OperationProfileResponse"
            }
          }
        }
      },
      "ItemsResponse": {
        "description": "Generic item collection.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ItemsResponse"
            }
          }
        }
      },
      "OkResponse": {
        "description": "Operation result.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OkResponse"
            }
          }
        }
      },
      "ErrorResponse": {
        "description": "API error.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "AnyRecord": {
        "type": "object",
        "additionalProperties": true
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "WechatLoginRequest": {
        "type": "object",
        "required": ["code"],
        "properties": {
          "code": {
            "type": "string"
          }
        }
      },
      "WechatPhoneLoginRequest": {
        "type": "object",
        "required": ["wxLoginCode", "phoneCode"],
        "properties": {
          "wxLoginCode": { "type": "string" },
          "phoneCode": { "type": "string" },
          "inviteCode": { "type": "string" },
          "scene": { "type": "string" },
          "promoterCode": { "type": "string" },
          "campaignCode": { "type": "string" },
          "redirectSource": { "type": "string" },
          "idempotencyKey": { "type": "string" }
        }
      },
      "SmsSendRequest": {
        "type": "object",
        "required": ["mobile"],
        "properties": {
          "mobile": { "type": "string" },
          "purpose": { "type": "string", "enum": ["login"] }
        }
      },
      "SmsSendResponse": {
        "type": "object",
        "required": ["sent", "retryAfterSeconds", "expiresInSeconds"],
        "properties": {
          "sent": { "type": "boolean" },
          "retryAfterSeconds": { "type": "integer" },
          "expiresInSeconds": { "type": "integer" }
        }
      },
      "SmsLoginRequest": {
        "type": "object",
        "required": ["mobile", "smsCode"],
        "properties": {
          "mobile": { "type": "string" },
          "smsCode": { "type": "string" },
          "inviteCode": { "type": "string" },
          "scene": { "type": "string" },
          "promoterCode": { "type": "string" },
          "campaignCode": { "type": "string" },
          "redirectSource": { "type": "string" },
          "idempotencyKey": { "type": "string" }
        }
      },
      "InviteValidationResponse": {
        "type": "object",
        "required": ["valid", "status"],
        "properties": {
          "valid": { "type": "boolean" },
          "status": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "RefreshTokenRequest": {
        "type": "object",
        "required": ["refreshToken"],
        "properties": {
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "RegisterByInviteRequest": {
        "type": "object",
        "required": ["username", "email", "password", "confirmPassword", "inviteCode"],
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string"
          },
          "confirmPassword": {
            "type": "string"
          },
          "inviteCode": {
            "type": "string"
          }
        }
      },
      "WorkspaceRole": {
        "type": "string",
        "enum": ["user", "agent", "admin"]
      },
      "AppRole": {
        "type": "string",
        "enum": ["USER", "AGENT", "OPERATION", "ENTERPRISE_ADMIN", "AI_ADMIN", "FINANCE", "CUSTOMER_SERVICE"]
      },
      "CurrentRoleRequest": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/AppRole"
          }
        }
      },
      "UserAccessProfile": {
        "type": "object",
        "required": ["userId", "tenantId", "organizationId", "roles", "currentRole", "permissions"],
        "properties": {
          "userId": { "type": "string" },
          "tenantId": { "type": "string" },
          "organizationId": { "type": "string" },
          "roles": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AppRole" }
          },
          "currentRole": { "$ref": "#/components/schemas/AppRole" },
          "permissions": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "AuthUser": {
        "type": "object",
        "required": ["id", "email", "name", "role", "status"],
        "properties": {
          "id": {
