            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SmsLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/AuthResponse"
          },
          "400": {
            "$ref": "#/components/responses/ErrorResponse"
          },
          "401": {
            "$ref": "#/components/responses/ErrorResponse"
          }
        }
      }
    },
    "/api/v1/invite/agent/resolve": {
      "get": {
        "operationId": "resolveAgentInvite",
