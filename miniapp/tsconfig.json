{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@dcloudio/types"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@xianzhi/api-client": ["../packages/api-client/src"],
      "@xianzhi/business-sdk": ["../packages/business-sdk/src"],
      "@xianzhi/design-token": ["../packages/design-token/src"],
      "@xianzhi/platform-adapter": ["../packages/platform-adapter/src"],
      "@xianzhi/shared-auth": ["../packages/shared-auth/src"],
      "@xianzhi/shared-types": ["../packages/shared-types/src"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "pages.config.ts",
    "manifest.config.ts",
    "vite.config.ts",
    "uno.config.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
