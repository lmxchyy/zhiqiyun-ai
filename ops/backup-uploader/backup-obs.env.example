# Copy to a root-readable secret file outside Git, then restrict it to 0600.
# Do not commit the populated file or pass credentials as process arguments.
BACKUP_OBJECT_PROVIDER=obs
BACKUP_OBS_BUCKET=<dedicated-backup-bucket>
BACKUP_OBS_ENDPOINT=https://obs.<region>.myhuaweicloud.com
BACKUP_OBS_REGION=<region>
BACKUP_OBS_SECURITY_PROVIDER=ECS

# Use only when ECS Agency is unavailable. Inject these values through the
# secret file at runtime; never place real values in this example or image.
# OBS_ACCESS_KEY_ID=<access-key-id>
# OBS_SECRET_ACCESS_KEY=<secret-access-key>
# OBS_SECURITY_TOKEN=<temporary-security-token>
