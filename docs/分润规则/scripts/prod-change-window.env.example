# CR-2026-OC-008 production change-window env template
# Fill secrets locally. Do not commit real passwords.

XIANZHI_ENV=production

# Production readonly (SSH tunnel example used in batch 8 prep)
# ssh -N -L 127.0.0.1:15433:172.18.0.2:5432 root@ai.zs-kjhn.cn
DATABASE_URL=postgresql://xianzhi_readonly:<SECRET>@127.0.0.1:15433/zhiqiyun?sslmode=disable
XIANZHI_PRODUCTION_READONLY_DATABASE_URL=postgresql://xianzhi_readonly:<SECRET>@127.0.0.1:15433/zhiqiyun?sslmode=disable

XIANZHI_PRODUCTION_OPERATION_CENTER_REFUND_PROVIDER_MAPPINGS=WECHAT_VIRTUAL=MANUAL
XIANZHI_PRODUCTION_OPERATION_CENTER_FINANCIAL_SUBMITTER_ID=98b945ba-878d-4c40-ae28-20ea3da1a6a5
XIANZHI_PRODUCTION_OPERATION_CENTER_FINANCIAL_APPROVER_ID=e7af2217-3e0b-4ce8-b29c-7f74a1a4091f

# Keep all schedulers and auto-approval OFF in the release gate window
XIANZHI_PRODUCTION_OPERATION_CENTER_REFUND_RETRY_SCHEDULER_ENABLED=false
XIANZHI_PRODUCTION_OPERATION_CENTER_REFUND_VERIFICATION_SCHEDULER_ENABLED=false
XIANZHI_PRODUCTION_OPERATION_CENTER_REWARD_RELEASE_SCHEDULER_ENABLED=false
XIANZHI_PRODUCTION_OPERATION_CENTER_MANUAL_REFUND_AUTO_APPROVAL_ENABLED=false
