{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xianzhi.ai/contracts/ppt/v2.1/deck.schema.json",
  "title": "Xianzhi PPT Generation V2.1 DeckRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "deckId",
    "revision",
    "deckSpec",
    "storyline",
    "outlinePlan",
    "designSystem",
    "assetManifest",
    "migrationTrace",
    "slides"
  ],
  "properties": {
    "contractVersion": { "const": "2.1" },
    "deckId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1 },
    "deckSpec": { "$ref": "#/$defs/deckSpec" },
    "storyline": { "$ref": "#/$defs/storyline" },
    "outlinePlan": { "$ref": "#/$defs/outlinePlan" },
    "designSystem": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/designSystem" },
    "assetManifest": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/asset" }
    },
    "migrationTrace": { "$ref": "#/$defs/migrationTrace" },
    "slides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/slide-ir.schema.json" }
    }
  },
  "$defs": {
    "deckSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "language", "author", "audience", "scenario", "source"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$" },
        "author": { "type": "string", "minLength": 1, "maxLength": 100 },
        "audience": { "type": "string", "minLength": 1, "maxLength": 200 },
        "scenario": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "taskId", "clientRequestId"],
          "properties": {
            "kind": { "const": "legacy-ppt-task" },
            "taskId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
            "clientRequestId": { "type": "string", "maxLength": 256 }
          }
        }
      }
    },
    "storyBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "role", "purpose", "objectiveId", "layoutId", "title", "message", "bulletPoints"],
      "properties": {
        "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "role": { "enum": ["cover", "content"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 500 },
        "objectiveId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "layoutId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "bulletPoints": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "storyline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "beats"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "beats": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/storyBeat" }
        }
      }
    },
    "slideObjective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sequence", "role", "layoutId", "title", "message", "bulletPoints"],
      "properties": {
        "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
        "role": { "enum": ["cover", "content"] },
        "layoutId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "bulletPoints": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "outlinePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slideObjectives"],
      "properties": {
        "slideObjectives": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/slideObjective" }
        }
      }
    },
    "ignoredField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "reason"],
      "properties": {
        "field": { "type": "string", "minLength": 1, "maxLength": 300 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "migrationTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "consumedFields", "ignoredFields", "unmappedFields"],
      "properties": {
        "adapter": { "const": "legacy-ppt-to-v2-phase1" },
        "consumedFields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 300 }
        },
        "ignoredFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/ignoredField" }
        },
        "unmappedFields": {
          "type": "array",
          "maxItems": 0
        }
      }
    }
  }
}
