{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xianzhi.ai/contracts/ppt/v2.1/slide-ir.schema.json",
  "title": "Xianzhi PPT Generation V2.1 SlideIR",
  "$defs": {
    "plainContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "const": "plain" },
        "text": { "type": "string", "minLength": 1, "maxLength": 5000 }
      }
    },
    "bulletContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "items"],
      "properties": {
        "kind": { "const": "bullets" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "textElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "slot", "content", "styleRole"],
      "properties": {
        "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "type": { "const": "text" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "content": {
          "oneOf": [
            { "$ref": "#/$defs/plainContent" },
            { "$ref": "#/$defs/bulletContent" }
          ]
        },
        "styleRole": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
      }
    },
    "shapeElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "slot", "shapeType", "styleRole"],
      "properties": {
        "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "type": { "const": "shape" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "shapeType": { "enum": ["rect", "roundRect", "ellipse"] },
        "styleRole": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" }
      }
    },
    "imageElement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "slot", "assetRef", "fit", "altText"],
      "properties": {
        "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "type": { "const": "image" },
        "slot": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "assetRef": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
        "fit": { "enum": ["cover", "contain"] },
        "altText": { "type": "string", "minLength": 1, "maxLength": 500 },
        "citationRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" }
        }
      }
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/textElement" },
        { "$ref": "#/$defs/shapeElement" },
        { "$ref": "#/$defs/imageElement" }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "sequence", "role", "layoutId", "backgroundToken", "speakerNotes", "elements"],
  "properties": {
    "id": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 100 },
    "role": { "enum": ["cover", "section", "content", "closing"] },
    "layoutId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
    "backgroundToken": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/colorToken" },
    "speakerNotes": { "type": "string", "minLength": 1, "maxLength": 5000 },
    "objectiveId": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" },
    "keyMessage": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "evidenceRequired": { "type": "boolean" },
    "citationRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://xianzhi.ai/contracts/ppt/v2.1/common.schema.json#/$defs/id" }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/element" }
    }
  }
}
