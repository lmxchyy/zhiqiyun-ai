{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@xianzhi/api-client": ["../packages/api-client/src"],
      "@xianzhi/platform-adapter": ["../packages/platform-adapter/src"],
      "@xianzhi/shared-auth": ["../packages/shared-auth/src"],
      "@xianzhi/shared-image-utils": ["../packages/shared-image-utils/src"],
      "@xianzhi/shared-types": ["../packages/shared-types/src"]
    },
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
